# URI de conexão com o MongoDB Atlas (substitua com as suas credenciais)
MONGODB_URI=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/<banco>

# Segredo para assinar os tokens JWT (use uma string longa e aleatória)
JWT_SECRET=seu_jwt_secret_aqui

# Porta em que a API irá rodar
PORT=4000

# URL do front-end (para configuração do CORS)
FRONTEND_URL=http://localhost:3000

# URL interna do servidor responsável pelo armazenamento dos arquivos
FILES_API_URL=http://localhost:3002

# Chave usada pela API para autenticar as requisições ao PostVision Files
FILES_API_KEY=

# URL pública da PostVision API.
# Em produção, substituir pela URL pública da API.
PUBLIC_API_URL=
